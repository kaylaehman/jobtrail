# JobTrail environment configuration
# Copy to .env and adjust if needed; defaults below work out of the box with `docker compose up`.

# --- PostgreSQL ---
POSTGRES_USER=jobtrail
POSTGRES_PASSWORD=jobtrail
POSTGRES_DB=jobtrail

# --- Backend ---
# Connection string used by Prisma inside the backend container.
DATABASE_URL=postgresql://jobtrail:jobtrail@db:5432/jobtrail?schema=public
BACKEND_PORT=8000
# URL the backend uses to reach the jobspy sidecar inside the compose network.
JOBSPY_URL=http://jobspy:8001

# --- Frontend ---
FRONTEND_PORT=3000
# Public URL the browser uses to reach the backend (host-mapped, not compose-internal).
VITE_API_URL=http://localhost:8000

# --- JobSpy sidecar ---
# Cache TTL for identical search queries (seconds). 10 minutes is the minimum per JobSpy rate-limit notes.
JOBSPY_CACHE_TTL=600
# Optional proxies for the python-jobspy client. Comma-separated list, e.g. "user:pass@host:port,host2:port".
# Leave blank to disable. LinkedIn rate-limits hard (~10th page per IP) so proxies are recommended for heavy use.
JOBSPY_PROXIES=
